# ======================================================================
# COMIKA Web — Environment Configuration
# Salin menjadi `.env` sebelum menjalankan `npm run build`.
#   cp .env.example .env
#
# VITE_API_URL:
# - Dev: set ke '/api/v1' (Vite proxy ke backend lokal di :8000)
# - Prod: URL absolut API, mis. https://comika.app/api/v1
#   (bila backend di subdomain: https://api.comika.app/api/v1)
# ======================================================================
VITE_API_URL=/api/v1

# Midtrans Snap JS Client Key
# Sandbox: dapatkan dari https://app.sandbox.midtrans.com
# Production: dapatkan dari https://app.midtrans.com
VITE_MIDTRANS_CLIENT_KEY=
VITE_MIDTRANS_IS_PRODUCTION=false

# URL download APK (untuk tombol download di /download)
# Dev: biarkan kosong (default /downloads/comika.apk)
# Prod: URL absolut, mis. https://comika.free.nf/downloads/comika.apk
VITE_APK_URL=
