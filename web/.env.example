# ======================================================================
# COMIKA Web — Environment Configuration
# Salin menjadi `.env` sebelum menjalankan `npm run build`.
#   cp .env.example .env
#
# VITE_API_URL:
# - Dev: biarkan kosong (default '/api/v1' diproxy Vite ke backend lokal).
# - Prod: URL absolut API, mis. https://comika.app/api/v1
#   (bila backend di subdomain: https://api.comika.app/api/v1)
# ======================================================================
VITE_API_URL=
