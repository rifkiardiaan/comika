# ======================================================================
# COMIKA — Environment Configuration
# Salin file ini menjadi `.env` lalu sesuaikan nilainya.
#   cp .env.example .env && php artisan key:generate
#
# Production (shared hosting): pastikan setidaknya APP_ENV=production,
# APP_DEBUG=false, APP_URL HTTPS, DB_*, dan CORS_ALLOWED_ORIGINS.
# Panduan lengkap: docs/deployment/01-shared-hosting.md
# ======================================================================

APP_NAME=COMIKA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# URL frontend (web React) — untuk link verifikasi & reset password di email
FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ----------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=comika
DB_USERNAME=root
DB_PASSWORD=

# ----------------------------------------------------------------------
# CORS — origin yang boleh memanggil API (pisahkan dengan koma).
# Dev: '*' boleh (banyak origin: web 5173, emulator, dll).
# Prod: daftar eksplisit, mis. https://comika.app
# ----------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=*

# ----------------------------------------------------------------------
# Trusted proxies & hosts — penting untuk deteksi HTTPS di shared hosting
# (SSL di-terminate di edge hosting, request diteruskan via HTTP internal).
# TrustProxies: '*' = percaya semua proxy (umum di shared hosting);
#   di VPS dengan proxy spesifik, ganti dengan daftar IP dipisah koma.
# TrustHosts: default = APP_URL + subdomain; tambah host lain dipisah koma.
# ----------------------------------------------------------------------
TRUSTED_PROXIES=*
TRUSTED_HOSTS=

# ----------------------------------------------------------------------
# Driver (MVP: semua berbasis file/local — kompatibel shared hosting)
# ----------------------------------------------------------------------
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Wajib true di production (HTTPS) agar session cookie tidak dikirim lewat HTTP
SESSION_SECURE_COOKIE=false

# ----------------------------------------------------------------------
# Token API (Laravel Sanctum)
# Prefix opsional agar token mudah dikenali di database
# ----------------------------------------------------------------------
SANCTUM_TOKEN_PREFIX=

# ----------------------------------------------------------------------
# Mail — verifikasi email & reset password (kode 6 digit + link)
# Dev: MAIL_MAILER=log → email ditulis ke storage/logs/laravel.log (tidak
#   benar-benar terkirim). Untuk mengirim ke inbox nyata, pakai SMTP milik
#   sendiri (hosting/cPanel, Gmail App Password, dll.):
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.hostingmu.com (atau smtp.gmail.com)
#   MAIL_PORT=587 (TLS) atau 465 (SSL)
#   MAIL_USERNAME=alamat@domainmu.com
#   MAIL_PASSWORD=password/app-password
#   MAIL_ENCRYPTION=tls (atau ssl untuk port 465)
# MAIL_FROM_ADDRESS harus pakai domain yang sama dengan MAIL_USERNAME
# agar tidak masuk spam. Setelah ubah, jalankan: php artisan config:clear
# ----------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@comika.app"
MAIL_FROM_NAME="${APP_NAME}"

# ----------------------------------------------------------------------
# Web Push (VAPID) — notifikasi browser (opsional)
# Generate pasangan kunci: php artisan webpush:keys
#   VAPID_SUBJECT    = mailto atau URL identitas server push
#   VAPID_PUBLIC_KEY = public key base64url (dikirim ke browser)
#   VAPID_PRIVATE_KEY= private key base64url (disimpan rahasia)
# Biarkan kosong bila fitur web push tidak dipakai — API subscribe
# akan menolak permintaan dan web tidak menampilkan opsi notifikasi.
# ----------------------------------------------------------------------
VAPID_SUBJECT=mailto:noreply@comika.app
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ----------------------------------------------------------------------
# AI Assistant (blueprint 27) — opsional, biarkan kosong bila tidak dipakai
# Client OpenAI-compatible (bekerja dengan OpenAI, Groq, OpenRouter, dll).
# Bila AI_API_KEY kosong, AiService memakai generator rule-based bawaan
# (tanpa API) agar fitur tetap berfungsi untuk demo.
# ----------------------------------------------------------------------
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=60

# ----------------------------------------------------------------------
# Midtrans Payment Gateway
# Dapatkan keys dari: https://app.sandbox.midtrans.com (sandbox)
# atau https://app.midtrans.com (production)
# ----------------------------------------------------------------------
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_CALLBACK_FINISH=/wallet?payment=success

# ----------------------------------------------------------------------
# Opsional (tidak dipakai MVP, biarkan kosong)
# ----------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
